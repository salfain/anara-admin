PORT=4000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/anara_quick_replies

# Wajib diisi. Server menolak jalan kalau kosong, terlalu pendek, atau masih
# memakai contoh — kunci yang bisa ditebak berarti token admin bisa dipalsukan.
# Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

CORS_ORIGIN=http://localhost:5173
